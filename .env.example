# Copy to .env.local. Same Supabase project as the mobile app (see ../.env).
# Only the public anon key is used — every admin read goes through RPCs that
# check public.admins on the database side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
